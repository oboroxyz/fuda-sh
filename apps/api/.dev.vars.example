# Copy to .dev.vars (gitignored). Leave SIGNER_PRIVATE_KEY and BASE_RPC_URL
# unset and set USE_FAKE_CHAIN=1 to run the api against an in-memory chain.
#
# It doubles as the deployment checklist. Anything marked `secret:` below is a
# `wrangler secret put` name, kept in `.dev.vars.production` (gitignored) as the
# source to push from. Anything marked `var:` is a public value that belongs in
# `wrangler.jsonc` for a deployment and appears here only because a local run
# reads every binding from this one file. Pushing a `var:` name as a secret
# defines it twice, and the secret silently wins. The runbook's §3 says what
# each one gates.
USE_FAKE_CHAIN=1
#SIGNER_PRIVATE_KEY=0x…                  # secret
#BASE_RPC_URL=https://sepolia.base.org   # secret
#ADMIN_TOKEN=change-me                   # secret

# ENS CCIP-Read stays disabled unless all four values are configured. The
# signer key authenticates gateway answers; the separate gateway secret derives
# deterministic +Private destinations. Never reuse either key elsewhere.
#ENS_PARENT_NAME=fuda.eth            # var
#ENS_RESOLVER_ADDRESSES=0x…          # var
#ENS_GATEWAY_SIGNER_KEY=0x…          # secret
#ENS_GATEWAY_SECRET=0x…              # secret

# Issuer name claims. All five must be present or every claim route answers
# 503 ens_not_configured and the dashboard hides the section
# (docs/specs/ens-naming.md#claiming-a-name-and-what-writes-the-mirror).
#
# ENS_VOUCHER_KEY must be the key the deployed registrar was given: it is what
# `voucherSigner()` returns on chain, and any other key makes the registrar
# reject the claim with InvalidSignature. It lives in
# `packages/ens-contracts/.env`, alongside the gateway signer.
#
# The two URLs are secrets rather than vars because an Alchemy endpoint carries
# its API key in the path. With Alchemy they are the same URL: the `pm_*`
# methods are served from the app's own RPC endpoint.
#ENS_VOUCHER_KEY=0x…                                            # secret
#ENS_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/…      # secret
#ENS_PAYMASTER_UPSTREAM=https://eth-sepolia.g.alchemy.com/v2/…   # secret
#ENS_REGISTRAR_ADDRESS=0x…                                       # var
#ENS_GAS_POLICY_ID=…                                             # var

# Wallet passes: set all four GOOGLE_* (resp. all five APPLE_*) or that pass
# endpoint answers 501. A PEM pasted straight out of a service-account JSON
# keeps its literal \n escapes; that form is accepted as-is.
#GOOGLE_ISSUER_ID=
#GOOGLE_CLASS_ID=
#GOOGLE_SA_EMAIL=
#GOOGLE_SA_KEY_PEM=
#APPLE_PASS_TYPE_ID=
#APPLE_TEAM_ID=
#APPLE_CERT_PEM=
#APPLE_KEY_PEM=
#APPLE_WWDR_PEM=
