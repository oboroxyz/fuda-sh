{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": "./src/*"
  },
  "scripts": {
    "dev": "cd targets/local && vp dev --port 8787",
    "deploy": "cd targets/develop && void deploy --platform cloudflare",
    "deploy:production": "cd targets/production && void deploy --platform cloudflare",
    "test": "vp test",
    "test:scripts": "vp test --config vite.scripts.config.ts",
    "migrate:local": "cd targets/local && void db migrate",
    "migrate:remote": "cd targets/develop && void connect --platform cloudflare && void db migrate --remote",
    "migrate:production": "cd targets/production && void connect --platform cloudflare && void db migrate --remote",
    "d1:local": "cd targets/local && void db execute",
    "register-schemas": "tsx scripts/register-schemas.ts",
    "attest-root-delegation": "tsx scripts/attest-root-delegation.ts",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "probe:venue-wallet": "tsx scripts/probe-venue-wallet.ts"
  },
  "dependencies": {
    "@fuda/chains": "workspace:*",
    "@fuda/ens-contracts": "workspace:*",
    "@fuda/pass": "workspace:*",
    "@fuda/sdk": "workspace:*",
    "@fuda/ui": "workspace:*",
    "@simplewebauthn/server": "^14.0.3",
    "@worldcoin/idkit-core": "^4.6.0",
    "@worldcoin/idkit-server": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "valibot": "^1.5.0",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "asn1js": "4.0.0",
    "drizzle-kit": "^0.31.11",
    "jsonc-parser": "3.3.1",
    "pkijs": "4.0.1",
    "vitest": "4.1.11",
    "void": "1.6.2"
  }
}
