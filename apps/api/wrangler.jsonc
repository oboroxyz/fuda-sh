{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fuda-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // api.fuda.sh is a custom domain of this Worker. `routes` is inheritable, so the
  // named `dev` environment below overrides it with an empty list: `wrangler dev
  // --env dev` never deploys, and a stray `wrangler deploy --env dev` must not
  // take the production hostname over.
  "routes": [{ "pattern": "api.fuda.sh", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fuda-beta",
      "database_id": "d4cd9c4d-8986-4bbc-a14d-15c453b6d620",
      "migrations_dir": "migrations",
    },
  ],
  // Venue logos. Create it with `wrangler r2 bucket create fuda-media` before
  // deploying; without the binding the upload route answers
  // 501 media_not_configured and every other surface works unbranded.
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "fuda-media" }],
  // Secrets (`wrangler secret put`, never `vars`): SIGNER_PRIVATE_KEY,
  // ENS_GATEWAY_SIGNER_KEY, ENS_GATEWAY_SECRET,
  // ADMIN_TOKEN, BASE_RPC_URL and the wallet-platform names —
  // GOOGLE_ISSUER_ID, GOOGLE_CLASS_ID, GOOGLE_SA_EMAIL, GOOGLE_SA_KEY_PEM
  // (all four, or GET /pass/:uid/google answers 501) and
  // APPLE_PASS_TYPE_ID, APPLE_TEAM_ID, APPLE_CERT_PEM, APPLE_KEY_PEM,
  // APPLE_WWDR_PEM (all five, or GET /pass/:uid/apple.pkpass answers 501).
  //
  // Deploy-time fills (docs/runbook.md replaces each one; every one of
  // them fails closed until it is): `d1_databases[].database_id` above, and below
  // EAS_SCHEMAS (empty sets → /issue answers 502 chain_error), ISSUER_ADDRESS and
  // DELEGATION_UID (zero → the same 502). ANNOUNCER_FROM_BLOCK is retained here
  // as the rights-subgraph manifest generation source; "0" makes graph:prepare
  // fail until production configuration is populated. ENS_PARENT_NAME and
  // ENS_RESOLVER_ADDRESSES stay absent until the matching resolver is deployed;
  // POST /ens/gateway then answers 503 rather than signing for placeholders.
  "vars": {
    "EAS_ADDRESS": "0x4200000000000000000000000000000000000021",
    "SCHEMA_REGISTRY_ADDRESS": "0x4200000000000000000000000000000000000020",
    "ANNOUNCER_ADDRESS": "0x55649E01B5Df198D18D95b5cc5051630cfD45564",
    "ANNOUNCER_FROM_BLOCK": "7552655",
    "FACTORY_ADDRESS": "0x0BA5ED0c6AA8c49038F819E587E2633c4A9F428a",
    "EAS_SCHEMAS": "{\"attendance\":[{\"uid\":\"0x22a41470aabe3a0edec1f9948975a887f21adddd6cf009e865e267cac6e10241\",\"version\":1}],\"entitlement\":[{\"uid\":\"0x42ffdba952267e373cb33ecf9fdc190fb27b30140d0695dabb8383bbed86d616\",\"version\":1}],\"issuerDelegation\":[{\"uid\":\"0x62c93e6e95f3956ba5937fc8454203ba781af5e455657952e915e71c3895f327\",\"version\":1}]}",
    "ISSUER_ADDRESS": "0xAA64E3814A88f4bA4588787EB04e5eACBabcd77E",
    "DELEGATION_UID": "0x7bb324ad1ec399488f18178153a046d7bcca44bb9688e72e0ce9581a61a6e155",
    "API_BASE_URL": "https://api.fuda.sh",
    "PUBLIC_BASE_URL": "https://fuda.sh",
  },
  // `wrangler dev --env dev` with USE_FAKE_CHAIN=1 (see .dev.vars.example): no
  // signer or RPC needed. ISSUER_ADDRESS/DELEGATION_UID/EAS_SCHEMAS below are
  // deterministic outputs of FakeChain's default signer and seedRootDelegation
  // (see src/index.ts) — the fake chain built on the first request re-derives
  // the same UIDs and address, so this block never needs regenerating.
  // Named environments don't inherit top-level `vars` or `d1_databases`, so
  // both are repeated here in full.
  "env": {
    "dev": {
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fuda-beta",
          "database_id": "d4cd9c4d-8986-4bbc-a14d-15c453b6d620",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "fuda-media" }],
      "vars": {
        "EAS_ADDRESS": "0x4200000000000000000000000000000000000021",
        "SCHEMA_REGISTRY_ADDRESS": "0x4200000000000000000000000000000000000020",
        "ANNOUNCER_ADDRESS": "0x55649E01B5Df198D18D95b5cc5051630cfD45564",
        "ANNOUNCER_FROM_BLOCK": "0",
        "FACTORY_ADDRESS": "0x0BA5ED0c6AA8c49038F819E587E2633c4A9F428a",
        "API_BASE_URL": "http://localhost:8787",
        "PUBLIC_BASE_URL": "http://localhost:5173",
        "ISSUER_ADDRESS": "0xF0F0F0f0f0F0F0f0f0F0f0f0f0f0F0F0f0f0f0F0",
        "DELEGATION_UID": "0xb10e2d527612073b26eecdfd717e6a320cf44b4afac2b0732d9fcbe2b7fa0cf6",
        "EAS_SCHEMAS": "{\"entitlement\":[{\"uid\":\"0x42ffdba952267e373cb33ecf9fdc190fb27b30140d0695dabb8383bbed86d616\",\"version\":1}],\"issuerDelegation\":[{\"uid\":\"0x62c93e6e95f3956ba5937fc8454203ba781af5e455657952e915e71c3895f327\",\"version\":1}],\"attendance\":[{\"uid\":\"0x22a41470aabe3a0edec1f9948975a887f21adddd6cf009e865e267cac6e10241\",\"version\":1}]}",
      },
    },
  },
}
