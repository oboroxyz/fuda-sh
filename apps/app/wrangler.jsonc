{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fuda-app",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-09-01",
  // SPA handling serves index.html for deep links. Workers Static Assets
  // canonicalizes a literal `@` in an otherwise unknown path to `%40`, so
  // handle routes run the Worker first and receive the SPA shell directly.
  "routes": [{ "pattern": "app.fuda.sh", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/@*"],
  },
}
