{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fuda-app",
  "compatibility_date": "2025-09-01",
  // Assets-only Worker: no `main`. app.fuda.sh and the fuda.sh apex are attached as custom
  // domains at deploy time (Plan 5); the apex landing is this app's `/` route (spec §13).
  // SPA handling so a deep link like /signed is served index.html and routed client-side.
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
}
