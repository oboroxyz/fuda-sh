# Copy to .env (gitignored) for a local build, or set these in the environment of
# `pnpm --filter app build` — Vite bakes them into the bundle at build time.

# The api origin this app calls. Defaults to http://localhost:8787 when unset.
VITE_API_BASE_URL=https://api.fuda.sh

# The origin the /signed gate and the /private screens must run on — the only one
# of this Worker's two hostnames the api's CORS list allows. The apex redirects
# there. Defaults to https://app.fuda.sh; set http://localhost:5173 for local dev,
# or the dev server bounces to production instead of running locally.
VITE_APP_ORIGIN=https://app.fuda.sh

# The WebAuthn relying-party id of every passkey ceremony. fuda.sh in production
# so the apex and app.fuda.sh share one passkey. Defaults to fuda.sh; set
# localhost for local dev, since a browser rejects an rp.id that is not a
# registrable suffix of the page's host.
VITE_RP_ID=fuda.sh
