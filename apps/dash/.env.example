# Copy to .env (gitignored) for a local build, or set these in the environment of
# `pnpm --filter dash build` — Vite bakes them into the bundle at build time.

# The API origin for deployed builds. Leave unset during local development to
# use the same-origin /api proxy, including over an SSH browser preview.
VITE_API_BASE_URL=https://api.fuda.sh

# Public rights-subgraph gateway (or a same-origin proxy). Never put a Graph
# Studio deploy key in this browser-visible variable.
VITE_GRAPH_RIGHTS_ENDPOINT=https://gateway.thegraph.com/api/<PUBLIC_KEY>/subgraphs/id/<SUBGRAPH_ID>

# fuda's own ERC-7677 paymaster endpoint, which the operator's wallet calls when
# it submits an ENS claim. This is the one VITE_* that carries the api's version
# prefix, because the wallet fetches the URL exactly as given rather than
# through the client that adds it. Leave it unset and the dashboard hides the
# claim section rather than offering a button that could only fail.
VITE_ENS_PAYMASTER_URL=https://api.fuda.sh/v1/ens/paymaster
