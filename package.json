{
  "name": "fuda",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter app --filter gate --filter dash run dev",
    "dev:api": "pnpm --filter api run dev",
    "dev:app": "pnpm --filter app run dev",
    "dev:gate": "pnpm --filter gate run dev",
    "dev:dash": "pnpm --filter dash run dev",
    "migrate:local": "pnpm --filter api run migrate:local",
    "migrate:remote": "pnpm --filter api run migrate:remote",
    "graph:build": "pnpm --ignore-workspace --dir packages/subgraphs/rights run build",
    "graph:codegen": "pnpm --ignore-workspace --dir packages/subgraphs/rights run codegen",
    "graph:prepare": "pnpm --ignore-workspace --dir packages/subgraphs/rights run graph:prepare",
    "graph:test": "pnpm --ignore-workspace --dir packages/subgraphs/rights run test",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp run --filter './apps/*' --filter './packages/*' test && pnpm --filter api test:scripts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "20.14.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.7",
    "vite-plus": "^0.3.0",
    "wrangler": "^4.129.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": ">=11.12.0 <12"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
