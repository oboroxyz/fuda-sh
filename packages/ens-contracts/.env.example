# Copy to .env (gitignored) and fill in. These names are read from the process
# environment by the ens:* scripts, which do not load this file themselves —
# export them before running, e.g. in fish:
#
#   for line in (grep -v '^#' .env | string match -r '.+'); set -gx (string split -m1 = $line); end
#
# Keys are separate roles on purpose (docs/specs/ens-naming.md). Never reuse the
# EAS signer, and never paste a key into a checked-in file.

# --- always required ---

# Ethereum Sepolia RPC. The Alchemy app URL embeds its API key, so treat this
# whole value as a secret.
ENS_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# --- parent registration (ens:parent:commit / ens:parent:reveal) ---

# The account that registers and owns fuda.eth, and becomes the User Registry's
# root principal. Needs Sepolia ETH for gas; the registration fee is MockUSDC,
# which the tooling mints.
ENS_PARENT_KEY=0x
ENS_PARENT_ADDRESS=0x
# Reused verbatim between commit and reveal.
ENS_COMMITMENT_SECRET=0x
# Seconds. 31536000 = one year.
ENS_PARENT_DURATION=31536000

# --- topology deployment (ens:topology:deploy) ---

# Signs the ClaimVoucher / RenewVoucher payloads. The api holds this same key as
# its ENS_VOUCHER_KEY secret.
ENS_VOUCHER_KEY=0x
# Signs EIP-3668 gateway responses. The api holds it as ENS_GATEWAY_SIGNER_KEY.
ENS_GATEWAY_SIGNER_KEY=0x

# --- resuming a partial deployment, and ens:verify ---
#
# Set these once each contract exists. ens:topology:deploy reports every address
# it confirms; ens:verify takes public values only and needs no key.

ENS_USER_REGISTRY_ADDRESS=0x
ENS_RESOLVER_ADDRESS=0x
ENS_REGISTRAR_ADDRESS=0x
ENS_VOUCHER_SIGNER_ADDRESS=0x
ENS_GATEWAY_SIGNER_ADDRESS=0x
