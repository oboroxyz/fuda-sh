{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/session-start.sh\"",
            "async": false
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": ["EnterWorktree", "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git worktree:*)"]
  }
}
