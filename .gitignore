# Environment files
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo
*.log
*.tgz

# OS and editor files
.DS_Store
*~

# Rust build output (archive/substreams). The two crates keep their lockfiles.
target/
Cargo.lock
!/archive/substreams/erc5564/Cargo.lock
!/archive/substreams/erc5564-eas-pipeline/Cargo.lock

# Local worktrees and private notes
.worktrees/
docs/internal

# e2e suite output (packages/e2e)
.e2e/

# Local screenshots and review evidence (not product assets)
/artifacts/

# Local Worker secrets (per-package)
.dev.vars
.dev.vars.*

# Signing key material. The Apple Pass Type ID certificate, its private key and
# the WWDR intermediate belong outside this repository entirely — they are read
# straight from their stored location into `wrangler secret put`. These patterns
# are a backstop against a stray copy, not a storage location.
*.pem
*.p12
*.cer
*.certSigningRequest

# wrangler local state
.wrangler/

# Claude Code per-user local state
.claude/settings.local.json
.claude/worktrees/

# Void local state and generated Cloudflare config (void.lock.json is committed)
.void/
.void-wrangler.jsonc
.cloudflare/
